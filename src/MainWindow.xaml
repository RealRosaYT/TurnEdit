<Window x:Class="TurnEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TurnEdit"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Untitled - TurnEdit" Height="800" Width="1000" KeyDown="Window_KeyDown" ResizeMode="CanResizeWithGrip" Closing="Window_Closing">
    <DockPanel>
		<Grid VerticalAlignment="Top" DockPanel.Dock="Top">
            <Menu x:Name="mainMenu" HorizontalAlignment="Left">
                <MenuItem Header="File" x:Name="fileNav">
                    <MenuItem Header="New" x:Name="newFileNav" Click="newFileNav_Click" InputGestureText="Ctrl+N" />
                    <MenuItem Header="Open" x:Name="openNav" Click="openNav_Click" InputGestureText="Ctrl+O" />
                    <MenuItem Header="Save" x:Name="saveNav" Click="saveNav_Click" InputGestureText="Ctrl+S" />
                    <MenuItem Header="Save As" x:Name="saveAsNav" Click="saveAsNav_Click" InputGestureText="Ctrl+S" />
                    <!--
                <MenuItem Header="Recently opened file" x:Name="recentlyOpenedFile">
                </MenuItem>
				-->
                    <MenuItem Header="Exit" x:Name="exitNav" Click="ExitTurnEdit" InputGestureText="Alt+F4" />
                </MenuItem>
                <MenuItem Header="View" x:Name="viewNav">
                    <MenuItem Header="Settings" x:Name="settingsNav" Click="settingsNav_Click" />
                    <MenuItem Header="Plugins" x:Name="pluginsNav" Click="pluginsNav_Click" />
                    <MenuItem Header="Line number" IsCheckable="True" IsChecked="True" Checked="IsLineNumberShowed_Checked" Unchecked="IsLineNumberShowed_Unchecked" x:Name="IsLineNumberShowed" />
                    <MenuItem Header="Search" x:Name="searchEngineNav">
                        <MenuItem Header="on Google" x:Name="searchOnGoogle" Click="searchOnGoogle_Click" />
                        <MenuItem Header="on Bing" x:Name="searchOnBing" Click="searchOnBing_Click" />
                    </MenuItem>
                    <!-- This feature is experimental, please implement this feature! -->
                    <!--
                    <MenuItem Header="Move line" x:Name="moveLineNav" Click="moveLineNav_Click" />
                    -->
                </MenuItem>
                <MenuItem Header="Edit" x:Name="editNav">
                    <MenuItem Header="Search" x:Name="searchNav" Click="searchNav_Click" InputGestureText="Ctrl+F" />
                    <MenuItem Header="Replace" x:Name="replaceNav" Click="replaceNav_Click" InputGestureText="Ctrl+H" />
                    <Separator />
                    <MenuItem Header="Insert date and time" x:Name="insertDateAndTimeNav" Click="insertDateAndTimeNav_Click" />
                    <Separator />
                    <MenuItem Header="Undo" x:Name="undoNav" InputGestureText="Ctrl+Z" Click="undoNav_Click" />
                    <MenuItem Header="Redo" x:Name="redoNav" InputGestureText="Ctrl+Y" Click="redoNav_Click" />
                    <Separator />
                    <MenuItem Header="Cut" x:Name="cutNav" InputGestureText="Ctrl+X" Click="cutNav_Click" />
                    <MenuItem Header="Copy" x:Name="copyNav" InputGestureText="Ctrl+C" Click="copyNav_Click" />
                    <MenuItem Header="Paste" x:Name="pasteNav" InputGestureText="Ctrl+V" Click="pasteNav_Click" />
                    <MenuItem Header="Paste with quotes" x:Name="pasteWithQuotes" InputGestureText="Ctrl+Q" Click="pasteWithQuotes_Click" />
                    <Separator />
                    <MenuItem Header="Delete current line" x:Name="deleteCurrentLine" InputGestureText="Ctrl+Enter" Click="deleteCurrentLine_Click" />
                    <MenuItem Header="Select all" x:Name="selectAllNav" InputGestureText="Ctrl+A" Click="selectAllNav_Click" />
                </MenuItem>
                <MenuItem Header="Window" x:Name="windowNav">
                    <MenuItem Header="New Window" x:Name="newWindowNav" Click="newWindowNav_Click" />
                </MenuItem>
                <MenuItem Header="Help" x:Name="helpNav">
                    <MenuItem Header="Help" x:Name="helpOfflineNav" Click="helpNav_Click" />
                    <MenuItem Header="Update Turnedit" x:Name="updaterNav" Click="updaterNav_Click" />
                    <MenuItem Header="About TurnEdit" x:Name="aboutTurnEditNav" Click="aboutTurnEditNav_Click" />
					<MenuItem Header="For developers" x:Name="forDevelopers" Visibility="Collapsed">
						<MenuItem Header="Throw a exception" x:Name="occurExc" Click="occurExc_Click" />
						<!--
						<MenuItem Header="Debug information" x:Name="debugInformation" />
						-->
					</MenuItem>
                </MenuItem>
            </Menu>
        </Grid>
        <!--
        <ToolBarTray VerticalAlignment="Top" DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="" />
            </ToolBar>
        </ToolBarTray>
        -->
        <StatusBar DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
            <StatusBarItem>
                <TextBlock Text="Line: 0" x:Name="lineStatus" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="Column: 0" x:Name="columnStatus" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="Total text count: 0" x:Name="totalTextCount" />
            </StatusBarItem>
        </StatusBar>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<TextBox IsReadOnly="True" x:Name="lineNumberTxtBox" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" Grid.Column="0" />
			<TextBox x:Name="mainTextBox" ScrollViewer.ScrollChanged="mainTextBox_ScrollChanged" x:FieldModifier="public" FontFamily="Segoe UI" AcceptsReturn="True" KeyUp="mainTextBox_KeyUp" TextChanged="mainTextBox_TextChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" Grid.Column="1" ScrollViewer.VerticalScrollBarVisibility="Auto" />
		</Grid>
    </DockPanel>
</Window>
