<Window x:Class="TurnEdit.PluginsLstWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TurnEdit"
        mc:Ignorable="d"
        Title="Plugins" Height="250" Width="300" ResizeMode="NoResize">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="pluginsLstView" Margin="10" Grid.Column="0" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Visible">
				<ListView.ItemTemplate>
					<DataTemplate>
						<TextBlock Margin="3" Text="{Binding PluginName}" />
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
            <StackPanel Grid.Column="1" Margin="10">
                <Button Content="Install" Margin="5" x:Name="installPlugin" Click="installPlugin_Click" />
                <Button Content="Property" Margin="5" x:Name="propertyPlugin" Click="propertyPlugin_Click" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
