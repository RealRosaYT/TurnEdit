<ui:FluentWindow x:Class="TurnEdit.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TurnEdit"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{DynamicResource About.Title}" Height="640" Width="400" ResizeMode="NoResize" MaxHeight="640" MinHeight="640" MaxWidth="400" MinWidth="400">
    <StackPanel Orientation="Vertical">
        <ui:TitleBar Title="{DynamicResource About.Title}" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Orientation="Horizontal" Margin="7">
            <Image x:Name="AppIconImage" Margin="5" MaxWidth="50" />
            <TextBlock Text="TurnEdit Version 0.0" FontSize="20" x:Name="versionText" Margin="0,14,0,0" />
        </StackPanel>
        <ui:InfoBar Severity="Warning" Title="{DynamicResource About.PrereleaseWarningShort}" Margin="7" Message="{DynamicResource About.PrereleaseWarningLong}" x:Name="preReleaseWarning" IsClosable="False" />
        <Border Background="LightGray" BorderBrush="LightGray" BorderThickness="1" x:Name="borderDebugInfo" CornerRadius="4" Margin="10">
            <StackPanel Orientation="Vertical">
                <ui:TextBlock Text="Debug info:" Margin="10" />
                <TextBlock Text="   - Common language runtime version: " Margin="5" x:Name="clrVersion" />
                <TextBlock Text="   - AppData: " x:Name="appdataForDebug" TextWrapping="Wrap" Margin="5" />
                <TextBlock Text="   - Installed directory: " Margin="5" x:Name="installedDirectory" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Background="LightGray" BorderBrush="LightGray" BorderThickness="1" x:Name="borderBuildInfo" CornerRadius="4" Margin="10">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Build info:" Margin="10" />
                <TextBlock Text="   - Build time: " x:Name="buildTime" Margin="5" TextWrapping="Wrap" />
                <TextBlock Text="   - Build environment: Windows X-Lite Optimum 11 25H2 Build 26200.7462, Visual Studio 2026" TextWrapping="Wrap" Margin="5" />
                <TextBlock Text="   - Build method: Visual Studio" />
            </StackPanel>
        </Border>
        <TextBlock Text="Copyright (c) 2025 youmu1948 All Rights Reserved." Margin="5" />
        <TextBlock Text="This text editor licensed by GNU GPL 3.0." x:Name="licenseText" Margin="5" />
        <Button Content="OK" Margin="3" x:Name="okButton" Click="okButton_Click" />
    </StackPanel>
</ui:FluentWindow>
