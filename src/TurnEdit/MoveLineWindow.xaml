<Window x:Class="TurnEdit.MoveLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TurnEdit"
        mc:Ignorable="d"
        Title="Move Line" Height="195" Width="300" ResizeMode="NoResize">
    <StackPanel>
		<TextBlock Text="To:" x:Name="moveLineToText" Margin="10" />
		<TextBox x:Name="moveLineTo" Margin="10" />
        <StackPanel Margin="10" Orientation="Horizontal">
			<Button x:Name="moveLine"
			Content="Move Line"
			Padding="10"
			Margin="10"
			Click="moveLine_Click" />
			<Button x:Name="cancelMoveLine"
			Content="Cancel"
			Padding="10"
			Margin="10"
			Click="cancelMoveLine_Click" />
		</StackPanel>
    </StackPanel>
</Window>
