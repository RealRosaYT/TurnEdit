<ui:FluentWindow x:Class="TurnEdit.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TurnEdit"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{DynamicResource Search.Title}" Height="195" Width="300" ResizeMode="NoResize">
    <StackPanel>
        <ui:TitleBar Title="{DynamicResource Search.Title}" />
        <TextBlock Text="{DynamicResource Search.Label}" Margin="10" FontSize="15" x:Name="searchTextblk" />
        <TextBox Margin="10" x:Name="searchText" />
        <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Search.ButtonFind}" Width="100" Margin="10" x:Name="searchButton" Click="searchButton_Click" />
            <Button Content="{DynamicResource Search.ButtonCancel}" Width="100" Margin="10" x:Name="closeSearch" Click="closeSearch_Click" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
