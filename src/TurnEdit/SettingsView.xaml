<UserControl x:Class="TurnEdit.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TurnEdit"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ナビゲーション（左） -->
        <ui:NavigationView x:Name="NavView" Grid.Column="0" SelectionChanged="NavView_SelectionChanged" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="navDesign" Content="Design" Tag="Design" />
                <ui:NavigationViewItem x:Name="navFileFolder" Content="File/Folder" Tag="FileFolder" />
                <ui:NavigationViewItem x:Name="navAI" Content="AI" Tag="AI" />
                <ui:NavigationViewItem x:Name="navOthers" Content="Others" Tag="Others" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <!-- コンテンツ（右） -->
        <Grid Grid.Column="1" Margin="8">
            <!-- Design パネル -->
            <ScrollViewer x:Name="DesignPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="Font" Margin="10" x:Name="fontTextblk" />
                    <ComboBox Margin="10" x:Name="txtfnt" ItemsSource="{x:Static Fonts.SystemFontFamilies}" />
                    <TextBlock Text="Theme Mode" Margin="10" x:Name="modeTextblk" />
                    <ComboBox Margin="10" x:Name="thememd">
                        <ComboBoxItem Content="Light" IsSelected="True" />
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Auto" />
                    </ComboBox>
                    <TextBlock Text="Font Size" Margin="10" x:Name="fontSizeTextblk" />
                    <TextBox x:Name="fontSize" Margin="10" PreviewTextInput="fontSize_PreviewTextInput" />
                    <ui:ToggleSwitch Content="Show line number" Margin="10" x:Name="showLineNumber" />
                    <ui:ToggleSwitch Content="Make URL clickable" Margin="10" x:Name="makeURLClickable" />
                </StackPanel>
            </ScrollViewer>

            <!-- File/Folder パネル -->
            <ScrollViewer x:Name="FileFolderPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="10">
                    <ui:ToggleSwitch Content="Deny file double open(Under construction)" Margin="10" IsChecked="False" x:Name="denyFiledblOpen" />
                    <ui:ToggleSwitch Content="Create file when file not exists" Margin="10" IsChecked="True" x:Name="createFileWhenFNotExists" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Default directory" x:Name="defaultDirectoryTextblk" Margin="10" />
                        <CheckBox IsChecked="False" Margin="10" x:Name="defaultDirectoryEnabled" Click="defaultDirectoryEnabled_Click" />
                    </StackPanel>
                    <TextBox x:Name="defaultDirectory" IsEnabled="False" />
                </StackPanel>
            </ScrollViewer>

            <!-- AI パネル -->
            <ScrollViewer x:Name="AIPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <ui:ToggleSwitch Margin="10" Content="Enable AI" x:Name="isAiEnabled" Checked="isAiEnabled_Checked" Unchecked="isAiEnabled_Unchecked" />
                    <TextBlock Text="Select model:" Margin="10" />
                    <ComboBox x:Name="aiSelectModel" Margin="10">
                        <ComboBoxItem Content="Gemini 2.5 Flash" Tag="gemini-2.5-flash" />
                        <ComboBoxItem Content="Gemini 2.5 Flash Lite" Tag="gemini-2.5-flash-lite" />
                        <ComboBoxItem Content="Gemini 2.5 Pro" Tag="gemini-2.5-pro" />
                        <ComboBoxItem Content="Gemini 3 Pro" Tag="gemini-3-pro-preview" />
                        <ComboBoxItem Content="GPT 5.1" Tag="gpt-5.1-2025-11-13" />
                        <ComboBoxItem Content="GPT 5 Mini" Tag="gpt-5-mini-2025-08-07" />
                        <ComboBoxItem Content="GPT 5 Nano" Tag="gpt-5-nano-2025-08-07" />
                        <ComboBoxItem Content="Grok 4.1" Tag="grok-4-1-fast-reasoning" />
                        <ComboBoxItem Content="Grok 4"  Tag="grok-4-fast-reasoning"/>
                        <ComboBoxItem Content="Grok 3" Tag="grok-3" />
                        <ComboBoxItem Content="Grok 3 Mini" Tag="grok-3-mini" />
                        <ComboBoxItem Content="Grok 2" Tag="grok-2-vision-1212" />
                    </ComboBox>
                    <TextBlock Text="API key:" Margin="10" />
                    <TextBox x:Name="aiApiKey" Margin="10" />
                    <ui:ToggleSwitch Content="Enable AI context menu" Margin="10" x:Name="isAiContextMenuEnabled" />
                </StackPanel>
            </ScrollViewer>

            <!-- Others パネル -->
            <ScrollViewer x:Name="OthersPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Language" x:Name="languageTextblk" Margin="10"/>
                    <ComboBox x:Name="languageCmbBox" Margin="10">
                        <ComboBoxItem Content="English" IsSelected="True" x:Name="englishLanguage" />
                        <ComboBoxItem Content="日本語" x:Name="japaneseLanguage" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Enable Developer feature" x:Name="developerFeatureTextBlk" Margin="10" />
                        <ui:ToggleSwitch IsChecked="False" Margin="10" x:Name="enableDeveloperFeature" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 下部ボタン -->
            <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                <Button Content="Apply" Padding="5" Margin="10" x:Name="applySettingsBtn" Click="applySettings" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
