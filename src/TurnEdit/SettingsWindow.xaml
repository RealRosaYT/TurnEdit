<ui:FluentWindow x:Class="TurnEdit.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TurnEdit"
		xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{DynamicResource Settings.Title}" Height="530" Width="350" ResizeMode="NoResize" MaxWidth="350" MaxHeight="530" MinHeight="530" MinWidth="350">
    <StackPanel>
        <StackPanel Orientation="Vertical">
            <ui:TextBlock Text="{DynamicResource Settings.Title}" Margin="10" FontSize="33" />
            <TabControl Height="420" Margin="10">
                <TabItem Header="{DynamicResource Settings.DesignTab}" x:Name="designTab">
                    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.Font}" Margin="10" x:Name="fontTextblk" />
                            <ComboBox Margin="10" x:Name="txtfnt" ItemsSource="{x:Static Fonts.SystemFontFamilies}"></ComboBox>
                            <TextBlock Text="{DynamicResource Settings.ThemeMode}" Margin="10" x:Name="modeTextblk" />
                            <ComboBox Margin="10" x:Name="thememd">
                                <ComboBoxItem Content="Light" IsSelected="True" />
                                <ComboBoxItem Content="Dark" />
                                <ComboBoxItem Content="Auto" />
                            </ComboBox>
                            <TextBlock Text="{DynamicResource Settings.FontSize}" Margin="10" x:Name="fontSizeTextblk" />
                            <TextBox x:Name="fontSize" Margin="10" PreviewTextInput="fontSize_PreviewTextInput" />
                            <ui:ToggleSwitch Content="{DynamicResource Settings.ShowLineNumber}" Margin="10" x:Name="showLineNumber" />
                            <ui:ToggleSwitch Content="{DynamicResource Settings.MakeUrlClickable}" Margin="10" x:Name="makeURLClickable" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource Settings.FileFolderTab}" x:Name="fileAndFolderTab">
                    <StackPanel Margin="10">
                        <ui:ToggleSwitch Content="{DynamicResource Settings.DenyFileDoubleOpen}" Margin="10" IsChecked="False" x:Name="denyFiledblOpen" />
                        <ui:ToggleSwitch Content="{DynamicResource Settings.CreateFileWhenNotExists}" Margin="10" IsChecked="True" x:Name="createFileWhenFNotExists" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Settings.DefaultDirectory}" x:Name="defaultDirectoryTextblk" Margin="10" />
                            <CheckBox IsChecked="False" Margin="10" x:Name="defaultDirectoryEnabled" Click="defaultDirectoryEnabled_Click" />
                        </StackPanel>
                        <TextBox x:Name="defaultDirectory" IsEnabled="False" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="AI" x:Name="aiTab">
                    <TabItem.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="0.814"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TabItem.RenderTransform>
                    <StackPanel>
                        <ui:ToggleSwitch Margin="10" Content="{DynamicResource Settings.EnableAI}" x:Name="isAiEnabled" Checked="isAiEnabled_Checked" Unchecked="isAiEnabled_Unchecked" />
                        <TextBlock Text="{DynamicResource Settings.SelectModel}" Margin="10" />
                        <ComboBox x:Name="aiSelectModel" Margin="10">
                            <ComboBoxItem Content="Gemini 2.5 Flash" Tag="gemini-2.5-flash" />
                            <ComboBoxItem Content="Gemini 2.5 Flash Lite" Tag="gemini-2.5-flash-lite" />
                            <ComboBoxItem Content="Gemini 2.5 Pro" Tag="gemini-2.5-pro" />
                            <ComboBoxItem Content="Gemini 3 Pro" Tag="gemini-3-pro-preview" />
                            <ComboBoxItem Content="GPT 5.1" Tag="gpt-5.1-2025-11-13" />
                            <ComboBoxItem Content="GPT 5 Mini" Tag="gpt-5-mini-2025-08-07" />
                            <ComboBoxItem Content="GPT 5 Nano" Tag="gpt-5-nano-2025-08-07" />
                            <ComboBoxItem Content="Grok 4.1" Tag="grok-4-1-fast-reasoning" />
                            <ComboBoxItem Content="Grok 4"  Tag="grok-4-fast-reasoning"/>
                            <ComboBoxItem Content="Grok 3" Tag="grok-3" />
                            <ComboBoxItem Content="Grok 3 Mini" Tag="grok-3-mini" />
                            <ComboBoxItem Content="Grok 2" Tag="grok-2-vision-1212" />
                        </ComboBox>
                        <TextBlock Text="{DynamicResource Settings.ApiKey}" Margin="10" />
                        <TextBox x:Name="aiApiKey" Margin="10" />
                        <ui:ToggleSwitch Content="{DynamicResource Settings.EnableAiContextMenu}" Margin="10" x:Name="isAiContextMenuEnabled" />

                    </StackPanel>
                </TabItem>
                <TabItem Header="{DynamicResource Settings.OthersTab}" x:Name="othersTab">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Language}" x:Name="languageTextblk" Margin="10"/>
                        <ComboBox x:Name="languageCmbBox" Margin="10" ItemsSource="{Binding LanguageInfos}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectionChanged="languageCmbBox_SelectionChanged" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Settings.EnableDeveloperFeature}" x:Name="developerFeatureTextBlk" Margin="10" />
                            <ui:ToggleSwitch IsChecked="False" Margin="10" x:Name="enableDeveloperFeature" />
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="False" Margin="10" x:Name="disableHardwareAcceleration" Content="{DynamicResource Settings.DisableHardwareAcceleration}" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
            <ui:Button Content="{DynamicResource Settings.Apply}" Padding="10" Margin="10" x:Name="applySettings" Click="applySettings_Click" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
