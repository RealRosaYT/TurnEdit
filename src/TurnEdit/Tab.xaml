<UserControl x:Class="TurnEdit.Tab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TurnEdit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Label x:Name="tabLabel" Content="No" HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Height="25" Margin="7" />
        <Button Content="X" Margin="60,0,0,0" VerticalAlignment="Top" Height="25" Width="25" x:Name="closeTab" Click="closeTab_Click" />
    </Grid>
</UserControl>
