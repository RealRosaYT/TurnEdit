    <sys:String x:Key="Menu.SelectAll">すべて選択</sys:String>

    <!-- Window -->
    <sys:String x:Key="Menu.NewWindow">新規ウィンドウ</sys:String>

    <!-- Help -->
    <sys:String x:Key="Help.Offline">ヘルプ</sys:String>
    <sys:String x:Key="Help.Update">TurnEdit をアップデート</sys:String>
    <sys:String x:Key="Help.About">TurnEdit について</sys:String>

