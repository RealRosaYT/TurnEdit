<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Main menu -->
    <sys:String x:Key="Menu.File">ファイル</sys:String>
    <sys:String x:Key="Menu.View">表示</sys:String>
    <sys:String x:Key="Menu.Edit">編集</sys:String>
    <sys:String x:Key="Menu.Window">ウィンドウ</sys:String>
    <sys:String x:Key="Menu.Languages">言語</sys:String>
    <sys:String x:Key="Menu.Help">ヘルプ</sys:String>

    <!-- File menu items -->
    <sys:String x:Key="Menu.New">新規作成</sys:String>
    <sys:String x:Key="Menu.Open">開く</sys:String>
    <sys:String x:Key="Menu.Save">上書き保存</sys:String>
    <sys:String x:Key="Menu.SaveAs">名前を付けて保存</sys:String>
    <sys:String x:Key="Menu.Exit">終了</sys:String>

    <!-- View menu -->
    <sys:String x:Key="Menu.Settings">設定</sys:String>
    <sys:String x:Key="Menu.SearchEngine">検索</sys:String>
    <sys:String x:Key="Menu.MoveLine">行を移動</sys:String>
    <sys:String x:Key="Menu.ScrollToEnd">末尾へ移動</sys:String>

    <!-- Edit menu -->
    <sys:String x:Key="Menu.Search">検索</sys:String>
    <sys:String x:Key="Menu.Replace">置き換え</sys:String>
    <sys:String x:Key="Menu.InsertDateTime">日付と時刻を挿入</sys:String>
    <sys:String x:Key="Menu.Undo">元に戻す</sys:String>
    <sys:String x:Key="Menu.Redo">やり直す</sys:String>
    <sys:String x:Key="Menu.Cut">切り取り</sys:String>
    <sys:String x:Key="Menu.Copy">コピー</sys:String>
    <sys:String x:Key="Menu.Paste">貼り付け</sys:String>
    <sys:String x:Key="Menu.PasteWithQuotes">引用符付きで貼り付け</sys:String>
