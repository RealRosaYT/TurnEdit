  <sys:String x:Key="Replace.ButtonReplace">置換</sys:String>
  <sys:String x:Key="Replace.ButtonReplaceAll">すべて置換</sys:String>
  <sys:String x:Key="Replace.ButtonCancel">キャンセル</sys:String>

  <!-- About / version info -->
  <sys:String x:Key="About.VersionLabel">バージョン:</sys:String>
  <sys:String x:Key="About.ReleaseDateLabel">リリース日:</sys:String>
  <sys:String x:Key="About.PrereleaseWarningShort">プレリリース</sys:String>
  <sys:String x:Key="About.PrereleaseWarningLong">これはプレリリース（プレビュー/ベータ）ビルドです。安定していない、または機能が未完成である可能性があります。自己責任でご利用ください。</sys:String>
    <sys:String x:Key="Settings.DisableHardwareAcceleration">ハードウェアアクセラレーションを無効にする</sys:String>
