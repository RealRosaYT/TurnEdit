    <sys:String x:Key="Settings.Language">言語</sys:String>
    <sys:String x:Key="Settings.EnableDeveloperFeature">開発者向け機能を有効にする</sys:String>
    <sys:String x:Key="Settings.Apply">適用</sys:String>
    <sys:String x:Key="Settings.OK">OK</sys:String>
    <sys:String x:Key="Settings.Cancel">キャンセル</sys:String>

