    <sys:String x:Key="Status.Line">行</sys:String>
    <sys:String x:Key="Status.Column">列</sys:String>
    <sys:String x:Key="Status.TotalTextCount">文字の総数</sys:String>

    <!-- Message boxes / errors -->
    <sys:String x:Key="Msg.PathNotAllowed">「path」は許可されていないパスです。</sys:String>
    <sys:String x:Key="Msg.FileOpenIOError">入出力エラーによりファイルを開く操作が失敗しました。</sys:String>
    <sys:String x:Key="Msg.FileOpenUnexpectedError">予期しないエラーによりファイルを開く操作が失敗しました。</sys:String>
    <sys:String x:Key="Msg.PleaseOpenFile">ファイルを開いてください。</sys:String>
    <sys:String x:Key="Msg.SaveIOError">入出力エラーによりファイル保存が失敗しました。</sys:String>
    <sys:String x:Key="Msg.SaveUnexpectedError">予期しないエラーによりファイル保存が失敗しました。</sys:String>
    <sys:String x:Key="Msg.UnsavedChangesQuestion">変更が保存されていません。変更を保存しますか?</sys:String>
    <sys:String x:Key="Msg.WindowCloseIOError">入出力エラーによりウィンドウを閉じる操作が失敗しました。保存されていない変更は失われます。TurnEdit を強制終了してください。</sys:String>
    <sys:String x:Key="Msg.WindowCloseSecurityError">セキュリティ違反によりウィンドウを閉じる操作が失敗しました。保存されていない変更は失われます。TurnEdit を強制終了してください。</sys:String>
    <sys:String x:Key="Msg.WindowCloseUnexpectedError">予期しないエラーによりウィンドウを閉じる操作が失敗しました。保存されていない変更は失われます。TurnEdit を強制終了してください。</sys:String>
    <sys:String x:Key="Msg.HelpFileNotFound">ヘルプファイルが見つかりません。</sys:String>
    <sys:String x:Key="Msg.FailedToOpenHelp">ヘルプを開けませんでした:</sys:String>
