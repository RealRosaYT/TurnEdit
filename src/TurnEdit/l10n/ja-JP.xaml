    <sys:String x:Key="Plugins.Title">プラグイン</sys:String>
    <sys:String x:Key="Plugins.InfoTemplate">プラグイン名: {0}\r\n説明: {1}\r\nバージョン: {2}\r\n作者: {3}</sys:String>
    <sys:String x:Key="About.Title">TurnEditについて</sys:String>

    <!-- AI helper messages -->
    <sys:String x:Key="AI.ErrorGeneratedNull">AI生成コンテンツがnullです。</sys:String>
    <sys:String x:Key="AI.UnsupportedModel">このAIモデルは対応していません。</sys:String>

    <!-- Generic -->
    <sys:String x:Key="Generic.Ok">OK</sys:String>
    <sys:String x:Key="Generic.Cancel">キャンセル</sys:String>
    <sys:String x:Key="Generic.Yes">はい</sys:String>
    <sys:String x:Key="Generic.No">いいえ</sys:String>
    <sys:String x:Key="Generic.Error">エラー</sys:String>
    <sys:String x:Key="Generic.Information">情報</sys:String>

    <sys:String x:Key="Title.Untitled">無題</sys:String>

