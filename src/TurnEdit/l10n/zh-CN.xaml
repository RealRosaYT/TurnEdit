<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Main menu -->
    <sys:String x:Key="Menu.File">文件</sys:String>
    <sys:String x:Key="Menu.View">视图</sys:String>
    <sys:String x:Key="Menu.Edit">编辑</sys:String>
    <sys:String x:Key="Menu.Window">窗口</sys:String>
    <sys:String x:Key="Menu.Languages">语言</sys:String>
    <sys:String x:Key="Menu.Help">帮助</sys:String>

    <!-- File menu items -->
    <sys:String x:Key="Menu.New">新建</sys:String>
    <sys:String x:Key="Menu.Open">打开</sys:String>
    <sys:String x:Key="Menu.Save">保存</sys:String>
    <sys:String x:Key="Menu.SaveAs">另存为</sys:String>
    <sys:String x:Key="Menu.Exit">退出</sys:String>

    <!-- View menu -->
    <sys:String x:Key="Menu.Settings">设置</sys:String>
    <sys:String x:Key="Menu.SearchEngine">搜索</sys:String>
    <sys:String x:Key="Menu.MoveLine">移动行</sys:String>
    <sys:String x:Key="Menu.ScrollToEnd">滚动到末尾</sys:String>

    <!-- Edit menu -->
    <sys:String x:Key="Menu.Search">搜索</sys:String>
    <sys:String x:Key="Menu.Replace">替换</sys:String>
    <sys:String x:Key="Menu.InsertDateTime">插入日期和时间</sys:String>
    <sys:String x:Key="Menu.Undo">撤销</sys:String>
    <sys:String x:Key="Menu.Redo">重做</sys:String>
    <sys:String x:Key="Menu.Cut">剪切</sys:String>
    <sys:String x:Key="Menu.Copy">复制</sys:String>
    <sys:String x:Key="Menu.Paste">粘贴</sys:String>
    <sys:String x:Key="Menu.PasteWithQuotes">带引号粘贴</sys:String>
    <sys:String x:Key="Menu.DeleteCurrentLine">删除当前行</sys:String>
    <sys:String x:Key="Menu.SelectAll">全选</sys:String>

    <!-- Window -->
    <sys:String x:Key="Menu.NewWindow">新窗口</sys:String>

    <!-- Help -->
    <sys:String x:Key="Help.Offline">帮助</sys:String>
    <sys:String x:Key="Help.Update">更新 TurnEdit</sys:String>
    <sys:String x:Key="Help.About">关于 TurnEdit</sys:String>

    <!-- Status -->
    <sys:String x:Key="Status.Line">行</sys:String>
    <sys:String x:Key="Status.Column">列</sys:String>
    <sys:String x:Key="Status.TotalTextCount">总字符数</sys:String>

    <!-- Message boxes / errors -->
    <sys:String x:Key="Msg.PathNotAllowed">该路径不被允许。</sys:String>
    <sys:String x:Key="Msg.FileOpenIOError">由于 I/O 错误，打开文件失败。</sys:String>
    <sys:String x:Key="Msg.FileOpenUnexpectedError">由于未知错误，打开文件失败。</sys:String>
    <sys:String x:Key="Msg.PleaseOpenFile">请打开文件。</sys:String>
    <sys:String x:Key="Msg.SaveIOError">由于 I/O 错误，保存文件失败。</sys:String>
    <sys:String x:Key="Msg.SaveUnexpectedError">由于未知错误，保存文件失败。</sys:String>
    <sys:String x:Key="Msg.UnsavedChangesQuestion">有未保存的更改。是否要保存更改？</sys:String>
    <sys:String x:Key="Msg.WindowCloseIOError">由于 I/O 错误，关闭窗口失败。未保存的更改将丢失，请强制退出 TurnEdit。</sys:String>
    <sys:String x:Key="Msg.WindowCloseSecurityError">由于安全违规，关闭窗口失败。未保存的更改将丢失，请强制退出 TurnEdit。</sys:String>
    <sys:String x:Key="Msg.WindowCloseUnexpectedError">由于未知错误，关闭窗口失败。未保存的更改将丢失，请强制退出 TurnEdit。</sys:String>
    <sys:String x:Key="Msg.HelpFileNotFound">未找到帮助文件。</sys:String>
    <sys:String x:Key="Msg.FailedToOpenHelp">无法打开帮助：</sys:String>
    <sys:String x:Key="Msg.ClipboardError">访问剪贴板时出错。</sys:String>
    <sys:String x:Key="Msg.UpdaterOpenError">无法打开更新程序：</sys:String>
    <sys:String x:Key="Msg.UpdaterNotFound">未找到更新程序可执行文件。</sys:String>
    <sys:String x:Key="Msg.FileTooLarge">文件过大。最大文件大小为 50MB。</sys:String>
    <sys:String x:Key="Msg.CantLoadPlugins">无法加载插件。</sys:String>
    <sys:String x:Key="Msg.PluginInstallFailure">插件安装失败。详情请查看调试控制台。</sys:String>
    <sys:String x:Key="Msg.InvalidPluginFormat">插件格式无效。</sys:String>
    <sys:String x:Key="Msg.PluginChecksumFailed">校验和验证失败。为安全起见，已中止插件安装。</sys:String>
    <sys:String x:Key="Msg.DeletePluginConfirm">确定要删除“{0}”插件吗？</sys:String>
    <sys:String x:Key="Msg.CriticalErrorWithDetails">应用程序发生严重错误。\r\n技术信息：\r\n {0}\r\n TurnEdit 将退出。</sys:String>
    <sys:String x:Key="Msg.CriticalError">应用程序发生严重错误。\r\n TurnEdit 将退出。</sys:String>
    <sys:String x:Key="Msg.UpdateAvailable">有可用更新。现在更新吗？</sys:String>

    <!-- Settings / UI labels -->
    <sys:String x:Key="Settings.Title">设置</sys:String>
    <sys:String x:Key="Settings.DesignTab">设计</sys:String>
    <sys:String x:Key="Settings.FileFolderTab">文件/文件夹</sys:String>
    <sys:String x:Key="Settings.OthersTab">其他</sys:String>

    <sys:String x:Key="Settings.Font">字体</sys:String>
    <sys:String x:Key="Settings.FontSize">字体大小</sys:String>
    <sys:String x:Key="Settings.ThemeMode">主题模式</sys:String>
    <sys:String x:Key="Settings.ShowLineNumber">显示行号</sys:String>
    <sys:String x:Key="Settings.MakeUrlClickable">使 URL 可点击</sys:String>
    <sys:String x:Key="Settings.DenyFileDoubleOpen">禁止重复打开文件（开发中）</sys:String>
    <sys:String x:Key="Settings.CreateFileWhenNotExists">文件不存在时创建文件</sys:String>
    <sys:String x:Key="Settings.DefaultDirectory">默认目录</sys:String>
    <sys:String x:Key="Settings.EnableAI">启用 AI</sys:String>
    <sys:String x:Key="Settings.SelectModel">选择模型：</sys:String>
    <sys:String x:Key="Settings.ApiKey">API 密钥：</sys:String>
    <sys:String x:Key="Settings.EnableAiContextMenu">启用 AI 右键菜单</sys:String>
    <sys:String x:Key="Settings.Language">语言</sys:String>
    <sys:String x:Key="Settings.EnableDeveloperFeature">启用开发者功能</sys:String>
    <sys:String x:Key="Settings.Apply">应用</sys:String>
    <sys:String x:Key="Settings.OK">确定</sys:String>
    <sys:String x:Key="Settings.Cancel">取消</sys:String>

    <!-- Plugins / About -->
    <sys:String x:Key="Plugins.Title">插件</sys:String>
    <sys:String x:Key="Plugins.InfoTemplate">插件名: {0}\r\n说明: {1}\r\n版本: {2}\r\n作者: {3}</sys:String>
    <sys:String x:Key="About.Title">关于 TurnEdit</sys:String>

    <!-- AI helper messages -->
    <sys:String x:Key="AI.ErrorGeneratedNull">AI 生成的内容为空。</sys:String>
    <sys:String x:Key="AI.UnsupportedModel">不支持指定的 AI 模型。</sys:String>

    <!-- Generic -->
    <sys:String x:Key="Generic.Ok">确定</sys:String>
    <sys:String x:Key="Generic.Cancel">取消</sys:String>
    <sys:String x:Key="Generic.Error">错误</sys:String>
    <sys:String x:Key="Generic.Information">信息</sys:String>

  <!-- Plugins: headers / buttons -->
  <sys:String x:Key="Plugins.NameHeader">名称</sys:String>
  <sys:String x:Key="Plugins.DescriptionHeader">说明</sys:String>
  <sys:String x:Key="Plugins.VersionHeader">版本</sys:String>
  <sys:String x:Key="Plugins.AuthorHeader">作者</sys:String>
  <sys:String x:Key="Plugins.Install">安装</sys:String>
  <sys:String x:Key="Plugins.Uninstall">卸载</sys:String>
  <sys:String x:Key="Plugins.Enable">启用</sys:String>
  <sys:String x:Key="Plugins.Disable">禁用</sys:String>
  <sys:String x:Key="Plugins.Update">更新</sys:String>
  <sys:String x:Key="Plugins.Details">详细</sys:String>
  <sys:String x:Key="Plugins.ConfirmUninstall">确定要卸载“{0}”插件吗？</sys:String>

  <!-- Language display names -->
  <sys:String x:Key="Language.English">English</sys:String>
  <sys:String x:Key="Language.Japanese">日本語</sys:String>
  <sys:String x:Key="Language.SimplifiedChinese">简体中文</sys:String>
  <sys:String x:Key="Language.Spanish">Español</sys:String>
  <sys:String x:Key="Language.Korean">한국어</sys:String>

  <!-- Search window -->
  <sys:String x:Key="Search.Title">搜索</sys:String>
  <sys:String x:Key="Search.Label">搜索内容：</sys:String>
  <sys:String x:Key="Search.ButtonFind">搜索</sys:String>
  <sys:String x:Key="Search.ButtonCancel">取消</sys:String>

  <!-- Replace window -->
  <sys:String x:Key="Replace.Title">替换</sys:String>
  <sys:String x:Key="Replace.LabelFind">要替换的文本：</sys:String>
  <sys:String x:Key="Replace.LabelReplace">替换为：</sys:String>
  <sys:String x:Key="Replace.ButtonReplace">替换</sys:String>
  <sys:String x:Key="Replace.ButtonReplaceAll">全部替换</sys:String>
  <sys:String x:Key="Replace.ButtonCancel">取消</sys:String>

  <!-- About / version info -->
  <sys:String x:Key="About.VersionLabel">版本：</sys:String>
  <sys:String x:Key="About.ReleaseDateLabel">发布日期：</sys:String>
  <sys:String x:Key="About.PrereleaseWarningShort">预发布</sys:String>
  <sys:String x:Key="About.PrereleaseWarningLong">此版本为预发布（预览/测试）版本，可能不稳定或功能未完成。请在了解风险的情况下使用。</sys:String>
  <sys:String x:Key="Title.Untitled">未命名</sys:String>
</ResourceDictionary>